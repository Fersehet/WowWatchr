# Kopiere diese Datei nach .env und trage deine Werte ein.

# Port für Editor und Overlay (http://localhost:PORT)
PORT=3312

# Login für den Editor (gilt überall, auch auf localhost). Bleibt das Passwort leer,
# gibt es keinen Login und jeder, der den Server erreicht, kann den Editor ändern.
# Das Overlay für OBS ist immer ohne Login lesbar.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Optional: Schlüssel für die Login-Cookies (sonst automatisch in data/session-secret)
SESSION_SECRET=

# Blizzard-Schlüssel von develop.battle.net (siehe README, "Real data").
# Ohne Schlüssel zeigt das Overlay Beispieldaten.
BLIZZARD_CLIENT_ID=
BLIZZARD_CLIENT_SECRET=
